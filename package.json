{
  "name": "rugby-graph",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "oxlint -c oxlint.json",
    "format": "oxfmt src tests playwright.config.ts vite.config.ts package.json oxlint.json",
    "format:check": "oxfmt --check src tests playwright.config.ts vite.config.ts package.json oxlint.json",
    "test:performance": "playwright test --config=playwright.config.ts tests/performance",
    "test:specifications": "playwright test --config=playwright.config.ts tests/specifications"
  },
  "dependencies": {
    "graphology": "0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "sigma": "4.0.0-beta.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@sveltejs/adapter-auto": "8.0.0-next.4",
    "@sveltejs/kit": "3.0.0-next.27",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.10.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.9.0",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@11.9.0"
}
