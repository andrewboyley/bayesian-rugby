{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": [
          "pnpx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--executablePath=/usr/bin/chromium"
        ],
        "disabled": false
      }
    }
  },
  "permissions": [
    {
      "action": "chrome-devtools_take_screenshot",
      "resource": "*",
      "effect": "deny"
    }
  ]
}
